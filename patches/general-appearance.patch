+// Downstream appearance applies to Nivlet only; nil inherits system changes.
+static int core_nivletAppearance(lua_State *L) {
+    const char *mode = luaL_checkstring(L, 1);
+    NSString *name = nil;
+    if (strcmp(mode, "dark") == 0) name = NSAppearanceNameDarkAqua;
+    else if (strcmp(mode, "light") == 0) name = NSAppearanceNameAqua;
+    else if (strcmp(mode, "system") != 0) return luaL_error(L, "Invalid appearance");
+    NSApp.appearance = name ? [NSAppearance appearanceNamed:name] : nil;
+    return 0;
+}
