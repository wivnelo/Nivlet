 - (NSApplicationTerminateReply)applicationShouldTerminate:(NSApplication *)sender {
+    LuaSkin *skin = [LuaSkin sharedWithState:NULL];
+    lua_State *L = skin.L;
+    if (!L) return NSTerminateNow;
+    int top = lua_gettop(L);
+    lua_getglobal(L, "hs");
+    if (lua_istable(L, -1)) {
+        lua_getfield(L, -1, "nivletShouldTerminate");
+        if (lua_isfunction(L, -1)) {
+            BOOL ok = [skin protectedCallAndError:@"Nivlet termination guard" nargs:0 nresults:1];
+            BOOL allow = ok && lua_toboolean(L, -1);
+            lua_settop(L, top);
+            if (!allow) return NSTerminateCancel;
+        }
+    }
+    lua_settop(L, top);
     MJLuaDestroy();
     return NSTerminateNow;
