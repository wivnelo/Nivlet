+@protocol NivletUpdaterAPI
+- (instancetype)initWithStartingUpdater:(BOOL)start updaterDelegate:(id)delegate userDriverDelegate:(id)driver;
+- (id<NivletUpdaterAPI>)updater;
+- (BOOL)startUpdater:(NSError **)error;
+- (BOOL)canCheckForUpdates;
+- (void)checkForUpdates:(id)sender;
+@end
+static NSString * const NivletPendingUpdateBuildKey = @"NivletPendingUpdateBuild";
+@interface NivletUpdateRecoveryDelegate : NSObject
+@end
+@implementation NivletUpdateRecoveryDelegate
+- (void)updaterWillRelaunchApplication:(id)updater {
+    NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+    [defaults setObject:[[NSBundle mainBundle] objectForInfoDictionaryKey:@"CFBundleVersion"] forKey:NivletPendingUpdateBuildKey];
+    [defaults synchronize];
+}
+- (void)updater:(id)updater didAbortWithError:(NSError *)error {
+    [[NSUserDefaults standardUserDefaults] removeObjectForKey:NivletPendingUpdateBuildKey];
+}
+@end
+static NivletUpdateRecoveryDelegate *nivletUpdateRecoveryDelegate;
+static id<NivletUpdaterAPI> nivletUpdaterController;
+static int core_nivletTakeUpdateRecovery(lua_State *L) {
+    LuaSkin *skin = [LuaSkin sharedWithState:L];
+    [skin checkArgs:LS_TBREAK];
+    NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+    NSString *previous = [defaults stringForKey:NivletPendingUpdateBuildKey];
+    BOOL incomplete = previous && [previous isEqualToString:[[NSBundle mainBundle] objectForInfoDictionaryKey:@"CFBundleVersion"]];
+    [defaults removeObjectForKey:NivletPendingUpdateBuildKey];
+    [defaults synchronize];
+    lua_pushboolean(L, incomplete);
+    return 1;
+}
+static int core_nivletCheckForUpdates(lua_State *L) {
+    LuaSkin *skin = [LuaSkin sharedWithState:L];
+    [skin checkArgs:LS_TBREAK];
+    if (!nivletUpdaterController) {
+        NSString *path = [[[NSBundle mainBundle] privateFrameworksPath] stringByAppendingPathComponent:@"Sparkle.framework"];
+        NSError *error = nil;
+        if (![[NSBundle bundleWithPath:path] loadAndReturnError:&error]) {
+            lua_pushboolean(L, NO); return 1;
+        }
+        Class controllerClass = NSClassFromString(@"SPUStandardUpdaterController");
+        if (!controllerClass) { lua_pushboolean(L, NO); return 1; }
+        nivletUpdateRecoveryDelegate = [NivletUpdateRecoveryDelegate new];
+        nivletUpdaterController = [(id<NivletUpdaterAPI>)[controllerClass alloc] initWithStartingUpdater:NO updaterDelegate:nivletUpdateRecoveryDelegate userDriverDelegate:nil];
+        if (![[nivletUpdaterController updater] startUpdater:&error]) {
+            nivletUpdaterController = nil;
+            [skin logError:[NSString stringWithFormat:@"Nivlet updater failed to start: %@", error.localizedDescription]];
+            lua_pushboolean(L, NO); return 1;
+        }
+    }
+    if (![[nivletUpdaterController updater] canCheckForUpdates]) { lua_pushboolean(L, NO); return 1; }
+    [nivletUpdaterController checkForUpdates:nil];
+    lua_pushboolean(L, YES);
+    return 1;
+}
+
+static int core_nivletQuit(lua_State *L) {
+    [[LuaSkin sharedWithState:L] checkArgs:LS_TBREAK];
+
+    dispatch_async(dispatch_get_main_queue(), ^{ [NSApp terminate:nil]; });
+    return 0;
+}
+
+static int core_nivletCurrentKeyEvent(lua_State *L) {
+    LuaSkin *skin = [LuaSkin sharedWithState:L];
+    [skin checkArgs:LS_TBREAK];
+    NSEvent *event = [NSApp currentEvent];
+    if (event.type != NSEventTypeKeyDown || !(event.modifierFlags & NSEventModifierFlagCommand)) {
+        lua_pushnil(L);
+        return 1;
+    }
+    [skin pushNSObject:@{@"key": event.charactersIgnoringModifiers ?: @"",
+                         @"metaKey": @YES,
+                         @"ctrlKey": @((event.modifierFlags & NSEventModifierFlagControl) != 0),
+                         @"altKey": @((event.modifierFlags & NSEventModifierFlagOption) != 0),
+                         @"shiftKey": @((event.modifierFlags & NSEventModifierFlagShift) != 0)}];
+    return 1;
+}
