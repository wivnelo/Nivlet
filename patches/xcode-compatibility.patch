+++ b/LuaSkin/LuaSkin-Base.xcconfig
@@ -44,7 +44,7 @@ GCC_NO_COMMON_BLOCKS = YES
 GCC_SYMBOLS_PRIVATE_EXTERN = NO
 
 // Other Warning Flags
-WARNING_CFLAGS = -Weverything -Wno-cstring-format-directive -Wno-padded -Wno-auto-import -Wno-missing-variable-declarations -Wno-objc-missing-property-synthesis -Wno-cast-qual -Wno-gnu-zero-variadic-macro-arguments -Wno-objc-messaging-id -Wno-declaration-after-statement -Wno-reserved-identifier
+WARNING_CFLAGS = -Wno-quoted-include-in-framework-header -Weverything -Wno-cstring-format-directive -Wno-padded -Wno-auto-import -Wno-missing-variable-declarations -Wno-objc-missing-property-synthesis -Wno-cast-qual -Wno-gnu-zero-variadic-macro-arguments -Wno-objc-messaging-id -Wno-declaration-after-statement -Wno-reserved-identifier -Wno-quoted-include-in-framework-header -Wno-implicit-void-ptr-cast -Wno-extra-semi-stmt -Wno-implicit-int-enum-cast -Wno-jump-misses-init
 
 // C Language Dialect
 GCC_C_LANGUAGE_STANDARD = gnu99
