diff --git a/Hammerspoon/Build Configs/Extensions-Ideal.xcconfig b/Hammerspoon/Build Configs/Extensions-Ideal.xcconfig
index acd180c..5ad7a25 100644
--- a/Hammerspoon/Build Configs/Extensions-Ideal.xcconfig	
+++ b/Hammerspoon/Build Configs/Extensions-Ideal.xcconfig	
@@ -12,7 +12,7 @@
 #include "Extensions-Base.xcconfig"
 
 // Add -Weverything to warning flags
-WARNING_CFLAGS = -Weverything $(inherited)
+WARNING_CFLAGS = -Weverything $(inherited) -Wno-quoted-include-in-framework-header -Wno-implicit-void-ptr-cast -Wno-extra-semi-stmt -Wno-implicit-int-enum-cast -Wno-jump-misses-init
 
 // Treat warnings as errors
 GCC_TREAT_WARNINGS_AS_ERRORS = YES
diff --git a/LuaSkin/LuaSkin-Base.xcconfig b/LuaSkin/LuaSkin-Base.xcconfig
index be3a47f..0cf3d8c 100644
